#!/bin/bash
#PBS -N saw_train
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110G
#PBS -l walltime=10:00:00
#PBS -J 0-2
#PBS -o /dev/null
#PBS -e /dev/null

set -euo pipefail

cd "${PBS_O_WORKDIR}"

export SLURM_SUBMIT_DIR="${PBS_O_WORKDIR}"
export SLURM_ARRAY_TASK_ID="${PBS_ARRAY_INDEX:-0}"
export SLURM_JOB_ID="${PBS_JOBID:-}"
export SLURM_JOB_NODELIST="$(hostname)"
CONDA_MODULE_DEFAULT="${CONDA_MODULE:-none}"
CONDA_EXE_DEFAULT="${CONDA_EXE:-conda}"
SCRATCH_ROOT_DEFAULT="${SCRATCH_ROOT:-${SCRATCH:-/scratch/${USER}}}"
export CONDA_EXE="${CONDA_EXE_DEFAULT}"
export SAVE_DIR="${SAVE_DIR:-${SCRATCH_ROOT_DEFAULT}/OGBench/exp}"
export DATASET_DIR="${DATASET_DIR:-${SCRATCH_ROOT_DEFAULT}/OGBench/data}"

mkdir -p logs/phase_4

LOG_FILE="logs/phase_4/pbs-${PBS_JOBNAME:-saw_train}-${PBS_JOBID:-unknown}_${PBS_ARRAY_INDEX:-0}.log"
exec >"${LOG_FILE}" 2>&1

for modules_init in \
  /usr/share/Modules/init/bash \
  /etc/profile.d/modules.sh \
  /usr/share/lmod/lmod/init/bash; do
  if [[ -f "${modules_init}" ]]; then
    # shellcheck source=/dev/null
    source "${modules_init}"
    break
  fi
done

if [[ "${CONDA_MODULE_DEFAULT}" != "none" ]] && command -v module >/dev/null 2>&1; then
  module load "${CONDA_MODULE_DEFAULT}"
fi

if ! command -v conda >/dev/null 2>&1; then
  if [[ -n "${CONDA_EXE_DEFAULT}" && -x "${CONDA_EXE_DEFAULT}" ]]; then
    conda_root="$(cd "$(dirname "${CONDA_EXE_DEFAULT}")/.." && pwd)"
    if [[ -f "${conda_root}/etc/profile.d/conda.sh" ]]; then
      # shellcheck source=/dev/null
      source "${conda_root}/etc/profile.d/conda.sh"
    fi
  fi
  for conda_sh in \
    "${HOME}/miniforge3/etc/profile.d/conda.sh" \
    "${HOME}/miniconda3/etc/profile.d/conda.sh" \
    "${HOME}/anaconda3/etc/profile.d/conda.sh"; do
    if [[ -f "${conda_sh}" ]]; then
      # shellcheck source=/dev/null
      source "${conda_sh}"
      break
    fi
  done
fi

exec bash "${PBS_O_WORKDIR}/slurm/train_saw.slurm"
