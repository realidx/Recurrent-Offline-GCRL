#!/bin/bash
#PBS -N crl_train
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110G
#PBS -l walltime=10:00:00
#PBS -J 0-2

set -euo pipefail

cd "${PBS_O_WORKDIR}"

export SLURM_SUBMIT_DIR="${PBS_O_WORKDIR}"
export SLURM_ARRAY_TASK_ID="${PBS_ARRAY_INDEX:-0}"
export SLURM_JOB_ID="${PBS_JOBID:-}"
export SLURM_JOB_NODELIST="$(hostname)"

mkdir -p logs/phase_5

LOG_FILE="logs/phase_5/pbs-${PBS_JOBNAME:-crl_train}-${PBS_JOBID:-unknown}_${PBS_ARRAY_INDEX:-0}.log"
exec >"${LOG_FILE}" 2>&1

for modules_init in \
  /usr/share/Modules/init/bash \
  /etc/profile.d/modules.sh \
  /usr/share/lmod/lmod/init/bash; do
  if [[ -f "${modules_init}" ]]; then
    # shellcheck source=/dev/null
    source "${modules_init}"
    break
  fi
done

if [[ "${CONDA_MODULE:-miniforge3/25.3.1}" != "none" ]] && command -v module >/dev/null 2>&1; then
  module load "${CONDA_MODULE:-miniforge3/25.3.1}"
fi

if ! command -v conda >/dev/null 2>&1; then
  if [[ -n "${CONDA_EXE:-}" && -x "${CONDA_EXE}" ]]; then
    conda_root="$(cd "$(dirname "${CONDA_EXE}")/.." && pwd)"
    if [[ -f "${conda_root}/etc/profile.d/conda.sh" ]]; then
      # shellcheck source=/dev/null
      source "${conda_root}/etc/profile.d/conda.sh"
    fi
  fi
  for conda_sh in \
    "${HOME}/miniforge3/etc/profile.d/conda.sh" \
    "${HOME}/miniconda3/etc/profile.d/conda.sh" \
    "${HOME}/anaconda3/etc/profile.d/conda.sh"; do
    if [[ -f "${conda_sh}" ]]; then
      # shellcheck source=/dev/null
      source "${conda_sh}"
      break
    fi
  done
fi

exec bash "${PBS_O_WORKDIR}/slurm/train_crl.slurm"
