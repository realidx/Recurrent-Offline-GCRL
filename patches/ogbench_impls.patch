+            u = nn.Dense(self.hidden_dim, name=f'fc_{layer_idx + 1}')(u)
+            if self.layer_norm:
+                u = nn.LayerNorm(name=f'ln_{layer_idx + 1}')(u)
+            u = self.activations(u)
