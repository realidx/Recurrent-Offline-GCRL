+class RecurTiedBackbone(nn.Module):
+    hidden_dim: int
+    out_dim: int
+    num_iters: int
+    num_dense_layers: int = 2
+    max_iters: int = 16
+    layer_norm: bool = True
+    ln_mode: str = 'per_layer_final'
+    layerscale_init: float = 1e-2
+    use_step_info: bool = False
+    use_sinusoidal_step_encoding: bool = False  # Enable continuous positional encoding
+    use_film: bool = True
+    film_mode: str = 'hidden'  # one of: hidden | context | hidden_context
+    use_layerscale: bool = True
+    use_act: bool = False
+    act_epsilon: float = 0.01
+    act_min_iters: int = 1
+    activations: Any = nn.gelu
+
+    @nn.compact
+    def __call__(self, x, num_iters=None, return_aux=False, context=None):
+        iters = self.num_iters if num_iters is None else int(num_iters)
+        num_dense_layers = int(self.num_dense_layers)
+        if num_dense_layers <= 0:
+            raise ValueError(f'num_dense_layers must be positive. Got {num_dense_layers}.')
+        if self.ln_mode not in ('pre_loop', 'per_layer', 'per_layer_final', 'pre_loop_per_layer'):
+            raise ValueError(
+                f"Unsupported ln_mode={self.ln_mode!r}. Use 'pre_loop', 'per_layer', 'per_layer_final', or 'pre_loop_per_layer'."
+            )
+        act_min_iters = int(self.act_min_iters)
+        if self.use_act and (act_min_iters <= 0 or act_min_iters > iters):
+            raise ValueError(f'act_min_iters must be in [1, num_iters]. Got act_min_iters={act_min_iters} num_iters={iters}.')
+
+        has_discrete_step_params = self.use_step_info and not self.use_sinusoidal_step_encoding
+        has_per_iter_alpha = self.use_layerscale
+        requires_iter_bound = has_discrete_step_params or has_per_iter_alpha
+        if requires_iter_bound and iters > self.max_iters:
+            raise ValueError(
+                f'num_iters={iters} exceeds max_iters={self.max_iters} for recur_tied with per-iteration parameters'
+            )
+
+        film_mode = str(self.film_mode)
+        if self.use_film and film_mode not in ('hidden', 'context', 'hidden_context'):
+            raise ValueError(f"Unsupported film_mode={film_mode!r}. Use 'hidden', 'context', or 'hidden_context'.")
+
+        h = nn.Dense(self.hidden_dim)(x)
+        use_hidden_film = self.use_film and film_mode in ('hidden', 'hidden_context')
+        use_context_film = self.use_film and film_mode in ('context', 'hidden_context')
+        if use_context_film:
+            if context is None:
+                raise ValueError(
+                    'RecurTiedBackbone with context-based FiLM requires a context tensor.'
+                )
+            context_proj = nn.Dense(self.hidden_dim, name='film_fc1_ctx')(context)
+        else:
+            context_proj = None
+
+        # Step embeddings: discrete lookup table OR continuous sinusoidal encoding
+        if self.use_step_info and not self.use_sinusoidal_step_encoding:
+            # Discrete: learnable lookup table (current approach)
+            step_embed = self.param(
+                'step_embed',
+                nn.initializers.normal(stddev=0.02),
+                (self.max_iters, self.hidden_dim),
+            )
+        else:
+            # Either no step info or continuous sinusoidal encoding (computed on-the-fly)
+            step_embed = None
+
+        alpha = None
