+        if stride <= 0:
+            raise ValueError(f'residual_stride must be positive. Got {stride}.')
+
+        h = x
+        block_input = h
+        for layer_index, size in enumerate(self.hidden_dims):
+            if layer_index % stride == 0:
+                block_input = h
+
+            h = nn.Dense(size, kernel_init=self.kernel_init, name=f'fc_{layer_index + 1}')(h)
+            h = self.activations(h)
+            if self.layer_norm:
+                h = nn.LayerNorm(name=f'ln_{layer_index + 1}')(h)
+
+            if (layer_index + 1) % stride == 0:
+                residual = block_input
+                if residual.shape[-1] != size:
+                    residual = nn.Dense(size, kernel_init=self.kernel_init, name=f'resid_proj_{(layer_index + 1) // stride}')(
+                        residual
+                    )
+                h = residual + h
+
+        return h
+
+
+class RecurrentBackbone(nn.Module):
+    """Single recurrent design: K iterations, each with m residual SwiGLU layers."""
+
+    hidden_dim: int
+    out_dim: int
+    k: int
+    m: int = 2
+    layer_norm: bool = True
+    layerscale_init: float = 1e-2
+
+    @nn.compact
+    def __call__(self, x, num_iters=None, return_aux=False, context=None):
+        del context
+        iters = self.k if num_iters is None else int(num_iters)
+        num_layers = int(self.m)
+        if iters <= 0:
+            raise ValueError(f'K must be positive. Got {iters}.')
+        if num_layers <= 0:
+            raise ValueError(f'm must be positive. Got {num_layers}.')
+
+        h = nn.Dense(self.hidden_dim, name='input_state_proj')(x)
+        initial_h = h
+
+        step_embeddings = self.param('step_embedding', nn.initializers.normal(stddev=0.02), (int(self.k), self.hidden_dim))
+        alpha = self.param('alpha', nn.initializers.constant(self.layerscale_init), (int(self.k),))
+        inner_layer_norms = (
+            [nn.LayerNorm(name=f'inner_ln_{layer_index + 1}') for layer_index in range(num_layers)]
+            if self.layer_norm
+            else None
+        )
+        swiglu_gate_layers = [nn.Dense(self.hidden_dim, name=f'swiglu_fc_a_{layer_index + 1}') for layer_index in range(num_layers)]
+        swiglu_value_layers = [nn.Dense(self.hidden_dim, name=f'swiglu_fc_b_{layer_index + 1}') for layer_index in range(num_layers)]
+        swiglu_out_layers = [nn.Dense(self.hidden_dim, name=f'swiglu_fc_o_{layer_index + 1}') for layer_index in range(num_layers)]
+        output_proj = nn.Dense(self.out_dim, name='output_proj')
+
+        hidden_steps = [] if return_aux else None
+        hidden_drift_steps = []
+        if iters > int(self.k):
+            raise ValueError(f'num_iters={iters} exceeds configured K={int(self.k)} for step-indexed parameters.')
+
+        for step_index in range(iters):
+            h_inner = h
+            step_embedding = step_embeddings[step_index]
+            for layer_index in range(num_layers):
+                u = h_inner
+                if inner_layer_norms is not None:
+                    u = inner_layer_norms[layer_index](u)
+                u = u + step_embedding
+                a_k = swiglu_gate_layers[layer_index](u)
+                b_k = swiglu_value_layers[layer_index](u)
+                g_k = jax.nn.silu(a_k) * b_k
+                delta = swiglu_out_layers[layer_index](g_k)
+                h_inner = h_inner + delta
+
+            h_next = h + alpha[step_index] * (h_inner - h)
+
+            initial_h_norm = jnp.linalg.norm(initial_h, axis=-1)
+            hidden_drift = jnp.linalg.norm(h_next - initial_h, axis=-1) / (initial_h_norm + 1e-8)
+            hidden_drift_steps.append(hidden_drift)
+            h = h_next
+            if hidden_steps is not None:
+                hidden_steps.append(h_next)
+
+        outputs = output_proj(h)
+        if return_aux:
+            hidden_stack = jnp.stack(hidden_steps, axis=0)
+            hidden_drift_steps = jnp.stack(hidden_drift_steps, axis=0)
+            return outputs, {
+                'value_step_outputs': output_proj(hidden_stack),
+                'hidden_drift_steps': hidden_drift_steps,
+                'hidden_drift': hidden_drift_steps[-1],
+                'final_hidden_norm': jnp.linalg.norm(h, axis=-1),
+            }
+        return outputs
+
+
+class UntiedSwiGLUBackbone(nn.Module):
+    """Depth-matched feedforward control for the recurrent SwiGLU backbone.
+
+    This backbone preserves the recurrent model's input/output projections,
+    step embeddings, LayerNorms, LayerScale parameters, and K-by-m sequence of
+    SwiGLU updates.  The only architectural difference is that every outer
+    refinement step owns independent update parameters instead of reusing one
+    shared update block.
+    """
+
+    hidden_dim: int
+    out_dim: int
+    k: int
+    m: int = 1
+    layer_norm: bool = True
+    layerscale_init: float = 1e-2
+
+    @nn.compact
+    def __call__(self, x, num_iters=None, return_aux=False, context=None):
+        del context
+        iters = self.k if num_iters is None else int(num_iters)
+        num_layers = int(self.m)
+        if iters <= 0:
+            raise ValueError(f'K must be positive. Got {iters}.')
+        if num_layers <= 0:
+            raise ValueError(f'm must be positive. Got {num_layers}.')
+        if iters > int(self.k):
+            raise ValueError(f'num_iters={iters} exceeds configured K={int(self.k)} for the untied backbone.')
+
+        h = nn.Dense(self.hidden_dim, name='input_state_proj')(x)
+        initial_h = h
+
+        step_embeddings = self.param(
+            'step_embedding',
+            nn.initializers.normal(stddev=0.02),
+            (int(self.k), self.hidden_dim),
+        )
+        alpha = self.param('alpha', nn.initializers.constant(self.layerscale_init), (int(self.k),))
+        output_proj = nn.Dense(self.out_dim, name='output_proj')
+
+        hidden_steps = [] if return_aux else None
+        hidden_drift_steps = []
+        for step_index in range(iters):
+            h_inner = h
+            step_embedding = step_embeddings[step_index]
+            for layer_index in range(num_layers):
+                step_number = step_index + 1
+                layer_number = layer_index + 1
+                u = h_inner
+                if self.layer_norm:
+                    u = nn.LayerNorm(name=f'step_{step_number}_inner_ln_{layer_number}')(u)
+                u = u + step_embedding
+                a_k = nn.Dense(
+                    self.hidden_dim,
+                    name=f'step_{step_number}_swiglu_fc_a_{layer_number}',
+                )(u)
+                b_k = nn.Dense(
+                    self.hidden_dim,
+                    name=f'step_{step_number}_swiglu_fc_b_{layer_number}',
+                )(u)
+                g_k = jax.nn.silu(a_k) * b_k
+                delta = nn.Dense(
+                    self.hidden_dim,
+                    name=f'step_{step_number}_swiglu_fc_o_{layer_number}',
+                )(g_k)
+                h_inner = h_inner + delta
+
+            h_next = h + alpha[step_index] * (h_inner - h)
+
+            initial_h_norm = jnp.linalg.norm(initial_h, axis=-1)
+            hidden_drift = jnp.linalg.norm(h_next - initial_h, axis=-1) / (initial_h_norm + 1e-8)
+            hidden_drift_steps.append(hidden_drift)
+            h = h_next
+            if hidden_steps is not None:
+                hidden_steps.append(h_next)
+
+        outputs = output_proj(h)
+        if return_aux:
+            hidden_stack = jnp.stack(hidden_steps, axis=0)
+            hidden_drift_steps = jnp.stack(hidden_drift_steps, axis=0)
+            return outputs, {
+                'value_step_outputs': output_proj(hidden_stack),
+                'hidden_drift_steps': hidden_drift_steps,
+                'hidden_drift': hidden_drift_steps[-1],
+                'final_hidden_norm': jnp.linalg.norm(h, axis=-1),
+            }
+        return outputs
+
+
+class InterpolationRecurrentUnit(nn.Module):
+    """Interpolation recurrent unit (IRU) used for latent computation."""
+
+    hidden_dim: int
+    layer_norm: bool = True
+
+    @nn.compact
+    def __call__(self, c, h, context):
+        combined = jnp.concatenate([context, h], axis=-1)
+        if self.layer_norm:
+            combined = nn.LayerNorm(name='recurrent_ln')(combined)
+        forget = nn.sigmoid(
+            nn.Dense(
+                self.hidden_dim,
+                bias_init=nn.initializers.constant(1.0),
+                name='forget',
+            )(combined)
+        )
+        candidate = jnp.tanh(nn.Dense(self.hidden_dim, name='input')(combined))
+        c_next = forget * c + (1.0 - forget) * candidate
+        h_next = jnp.tanh(c_next)
+        return c_next, h_next
+
+
+class IRUBackbone(nn.Module):
+    """IRU-(K) backbone with weights shared across thinking steps."""
+
+    hidden_dim: int
+    out_dim: int
+    k: int = 4
+    num_layers: int = 1
+    layer_norm: bool = True
+
+    @nn.compact
+    def __call__(self, x, num_iters=None, return_aux=False, context=None):
+        del context
+        iters = int(self.k) if num_iters is None else int(num_iters)
+        num_layers = int(self.num_layers)
+        if iters <= 0:
+            raise ValueError(f'K must be positive. Got {iters}.')
+        if num_layers <= 0:
+            raise ValueError(f'num_layers must be positive. Got {num_layers}.')
+
+        context = nn.Dense(self.hidden_dim, name='input_proj')(x)
+        if self.layer_norm:
+            context = nn.LayerNorm(name='input_ln')(context)
+
+        batch_dims = context.shape[:-1]
+        c = jnp.zeros((*batch_dims, self.hidden_dim), dtype=context.dtype)
+        h = jnp.zeros((*batch_dims, self.hidden_dim), dtype=context.dtype)
+        cells = [
+            InterpolationRecurrentUnit(
+                hidden_dim=self.hidden_dim,
+                layer_norm=self.layer_norm,
+                name=f'iru_layer_{layer_index + 1}',
+            )
+            for layer_index in range(num_layers)
+        ]
+        output_proj = nn.Dense(self.out_dim, name='output_proj')
+
+        hidden_steps = [] if return_aux else None
+        hidden_drift_steps = []
+        context_norm = jnp.linalg.norm(context, axis=-1)
+        for _ in range(iters):
+            residual = h
+            for cell in cells:
+                c, h = cell(c, h, context)
+            h = residual + h
+            hidden_drift_steps.append(jnp.linalg.norm(h, axis=-1) / (context_norm + 1e-8))
+            if hidden_steps is not None:
+                hidden_steps.append(h)
+
+        outputs = output_proj(h)
+        if return_aux:
+            hidden_stack = jnp.stack(hidden_steps, axis=0)
+            hidden_drift_steps = jnp.stack(hidden_drift_steps, axis=0)
+            return outputs, {
+                'value_step_outputs': output_proj(hidden_stack),
+                'hidden_drift_steps': hidden_drift_steps,
+                'hidden_drift': hidden_drift_steps[-1],
+                'final_hidden_norm': jnp.linalg.norm(h, axis=-1),
+            }
+        return outputs
+
+
+def recurrent_backbone_cls_and_kwargs(
+    backbone,
+    *,
+    hidden_dim,
+    out_dim,
+    k,
+    m,
+    layer_norm,
+    layerscale_init,
+):
+    backbone = str(backbone)
+    if backbone == 'recur':
+        return RecurrentBackbone, dict(
+            hidden_dim=hidden_dim,
+            out_dim=out_dim,
+            k=int(k),
+            m=int(m),
+            layer_norm=layer_norm,
+            layerscale_init=layerscale_init,
+        )
+    if backbone == 'untied':
+        return UntiedSwiGLUBackbone, dict(
+            hidden_dim=hidden_dim,
+            out_dim=out_dim,
+            k=int(k),
+            m=int(m),
+            layer_norm=layer_norm,
+            layerscale_init=layerscale_init,
+        )
+    if backbone == 'iru':
+        return IRUBackbone, dict(
+            hidden_dim=hidden_dim,
+            out_dim=out_dim,
+            k=int(k),
+            num_layers=int(m),
+            layer_norm=layer_norm,
+        )
+    raise ValueError(f'Unsupported backbone: {backbone}')
+
