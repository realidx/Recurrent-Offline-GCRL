+def _deep_has_key(obj, pred) -> bool:
+    if isinstance(obj, dict):
+        for k, v in obj.items():
+            try:
+                if pred(k):
+                    return True
+            except Exception:
+                pass
+            if _deep_has_key(v, pred):
+                return True
+        return False
+    if isinstance(obj, (list, tuple)):
+        return any(_deep_has_key(v, pred) for v in obj)
+    return False
