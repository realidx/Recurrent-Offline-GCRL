+class DeepResNetBackbone(nn.Module):
+    hidden_dim: int
+    out_dim: int
+    num_blocks: int
+    layer_norm: bool = True
+    layerscale_init: float = 1e-2
+    use_film: bool = False
+    activations: Any = nn.gelu
+
+    @nn.compact
+    def __call__(self, x):
+        h = nn.Dense(self.hidden_dim)(x)
+        block_embed = None
+        if self.use_film:
+            block_embed = self.param(
+                'block_embed',
+                nn.initializers.normal(stddev=0.02),
+                (int(self.num_blocks), self.hidden_dim),
+            )
+        for block_idx in range(int(self.num_blocks)):
+            step_embed = None if block_embed is None else block_embed[block_idx]
+            h = ResNetBlock(
+                self.hidden_dim,
+                layer_norm=self.layer_norm,
+                layerscale_init=self.layerscale_init,
+                use_film=self.use_film,
+                activations=self.activations,
+                name=f'resblock_{block_idx + 1}',
+            )(h, step_embed)
+        return nn.Dense(self.out_dim)(h)
