+def _infer_recur_tied_ln_from_ckpt(restore_dir: str, restore_epoch: int | None) -> bool | None:
+    """Infer whether the checkpoint was trained with tied LayerNorm (key 'ln') or per-iter LNs ('LayerNorm_k')."""
+    epoch = restore_epoch if restore_epoch is not None else _infer_latest_epoch_from_dir(restore_dir)
+    if epoch is None:
+        return None
+    params_path = os.path.join(restore_dir, f'params_{epoch}.pkl')
+    if not os.path.exists(params_path):
+        return None
+    try:
+        with open(params_path, 'rb') as f:
+            load_dict = pickle.load(f)
+    except Exception:
+        return None
+
+    agent_state = load_dict.get('agent', {})
+    try:
+        phi = agent_state.get('network', {}).get('params', {}).get('modules_critic', {}).get('phi', None)
+    except Exception:
+        phi = None
+
+    if isinstance(phi, dict):
+        if 'ln' in phi:
