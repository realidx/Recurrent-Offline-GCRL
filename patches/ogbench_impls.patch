+            alpha = self.param('alpha', nn.initializers.constant(self.layerscale_init), (self.max_iters,))
+
+        step_proj = nn.Dense(self.hidden_dim, use_bias=False, name='step_proj') if self.use_step_info else None
+        film_fc1_h = nn.Dense(self.hidden_dim) if use_hidden_film else None
+        film_fc2 = nn.Dense(2 * self.hidden_dim) if self.use_film else None
+        act_halting = nn.Dense(1, name='act_halting') if self.use_act else None
+
+        tied_layers = [
+            nn.Dense(self.hidden_dim, name=f'tied_fc{i + 1}') for i in range(num_dense_layers)
+        ]
+
+        tied_layer_norms = None
+        if self.layer_norm:
+            if self.ln_mode == 'pre_loop':
+                tied_layer_norms = [nn.LayerNorm(name='ln')]
+            elif self.ln_mode == 'pre_loop_per_layer':
+                num_layer_norms = num_dense_layers - 1
+                tied_layer_norms = [nn.LayerNorm(name='ln')]
+                for layer_index in range(num_layer_norms):
+                    tied_layer_norms.append(nn.LayerNorm(name=f'ln_{layer_index + 1}'))
+            else:
+                num_layer_norms = num_dense_layers if self.ln_mode == 'per_layer_final' else num_dense_layers - 1
+                tied_layer_norms = []
+                for layer_index in range(num_layer_norms):
+                    ln_name = 'ln' if layer_index == 0 else f'ln_{layer_index + 1}'
+                    tied_layer_norms.append(nn.LayerNorm(name=ln_name))
+
+        if self.use_step_info and not self.use_sinusoidal_step_encoding:
+            step_contributions = step_proj(step_embed)  # (max_iters, hidden_dim)
+        else:
+            step_contributions = None
+
+        act_expected_steps = None
+        act_accumulated = None
+        act_weighted_h = None
+        if self.use_act:
+            act_expected_steps = jnp.zeros(h.shape[:-1], dtype=h.dtype)
+            act_accumulated = jnp.zeros(h.shape[:-1], dtype=h.dtype)
+            act_weighted_h = jnp.zeros_like(h)
+
+        for k in range(iters):
+            h1 = h
+            if self.layer_norm and self.ln_mode in ('pre_loop', 'pre_loop_per_layer'):
+                h1 = tied_layer_norms[0](h1)
+
+            if self.use_step_info:
+                if not self.use_sinusoidal_step_encoding:
+                    step_contrib_k = step_contributions[k]
+                else:
+                    step_emb_k = sinusoidal_step_encoding(k, self.max_iters, self.hidden_dim)
+                    step_contrib_k = step_proj(step_emb_k)
+            else:
+                step_contrib_k = None
+
+            if self.use_film:
+                fc1_out = film_fc1_h(h1) if film_fc1_h is not None else None
+                if context_proj is not None:
+                    fc1_out = context_proj if fc1_out is None else fc1_out + context_proj
+                if step_contrib_k is not None:
+                    fc1_out = step_contrib_k if fc1_out is None else fc1_out + step_contrib_k
+                if fc1_out is None:
+                    fc1_out = jnp.zeros_like(h1)
+                film = film_fc2(self.activations(fc1_out))
+                gamma, beta = jnp.split(film, 2, axis=-1)
+                u = (1.0 + gamma) * h1 + beta
+            else:
+                u = h1 if step_contrib_k is None else h1 + step_contrib_k
+
+            for layer_index, layer in enumerate(tied_layers):
+                u = layer(u)
+                apply_layer_norm = (
+                    self.layer_norm
+                    and self.ln_mode in ('per_layer', 'per_layer_final', 'pre_loop_per_layer')
+                    and (layer_index < len(tied_layers) - 1 or self.ln_mode == 'per_layer_final')
+                )
+                if apply_layer_norm:
+                    if self.ln_mode == 'pre_loop_per_layer':
+                        u = tied_layer_norms[layer_index + 1](u)
+                    else:
+                        u = tied_layer_norms[layer_index](u)
+                if layer_index < len(tied_layers) - 1:
+                    u = self.activations(u)
+
+            if self.use_layerscale:
+                alpha_k = alpha[k]
+                h_next = h + alpha_k * u
+            else:
+                h_next = h + u
+
+            if self.use_act:
+                still_running = (act_accumulated < (1.0 - self.act_epsilon)).astype(h.dtype)
+                if k + 1 < act_min_iters:
+                    halt_prob = jnp.zeros(h.shape[:-1], dtype=h.dtype)
+                elif k + 1 == iters:
+                    halt_prob = jnp.ones(h.shape[:-1], dtype=h.dtype)
+                else:
+                    halt_prob = nn.sigmoid(act_halting(h_next)).squeeze(-1)
+                remaining = jnp.maximum(1.0 - act_accumulated, 0.0)
+                will_halt = ((act_accumulated + halt_prob) >= (1.0 - self.act_epsilon)) | (k + 1 == iters)
+                halt_weight = jnp.where(will_halt, remaining, halt_prob) * still_running
+                act_accumulated = act_accumulated + halt_weight
+                act_expected_steps = act_expected_steps + halt_weight * float(k + 1)
+                act_weighted_h = act_weighted_h + halt_weight[..., None] * h_next
+
+            h = h_next
+
+        final_h = act_weighted_h if self.use_act else h
+        outputs = nn.Dense(self.out_dim)(final_h)
+
+        if return_aux:
+            aux = {}
+            if self.use_act:
+                aux['act_expected_steps'] = act_expected_steps
+            aux['final_hidden_norm'] = jnp.linalg.norm(final_h, axis=-1)
+            return outputs, aux
+
