+def _infer_latest_epoch_from_dir(restore_dir: str) -> int | None:
+    try:
+        epochs = []
+        for p in glob.glob(os.path.join(restore_dir, 'params_*.pkl')):
+            base = os.path.basename(p)
+            try:
+                epochs.append(int(base.split('_', 1)[1].split('.', 1)[0]))
+            except Exception:
+                continue
+        return max(epochs) if epochs else None
+    except Exception:
+        return None
