diff --git a/impls/main.py b/impls/main.py
index d7a5df6..854757a 100644
--- a/impls/main.py
+++ b/impls/main.py
@@ -349,6 +349,58 @@ def main(_):
         eval_metrics['evaluation/Q_std'] = float(q_vals.std())
         eval_metrics['evaluation/Q_abs_max'] = float(np.abs(q_vals).max())
 
+        # ---------------------------------------------------------------------
+        # Extra eval diagnostics (helps debug instability / overfitting).
+        # ---------------------------------------------------------------------
+        # Ensemble disagreement / pessimism (actor uses min over ensemble).
+        try:
+            if q_vals.ndim >= 2 and q_vals.shape[0] == 2:
+                q1, q2 = q_vals[0], q_vals[1]
+                q_min = np.minimum(q1, q2)
+                eval_metrics['evaluation/critic_q1_mean'] = float(np.mean(q1))
+                eval_metrics['evaluation/critic_q2_mean'] = float(np.mean(q2))
+                eval_metrics['evaluation/critic_q_min_mean'] = float(np.mean(q_min))
+                eval_metrics['evaluation/critic_ensemble_disagreement'] = float(np.mean(np.std(q_vals, axis=0)))
+                eval_metrics['evaluation/critic_q1_abs_max'] = float(np.max(np.abs(q1)))
+                eval_metrics['evaluation/critic_q2_abs_max'] = float(np.max(np.abs(q2)))
+            elif q_vals.ndim >= 2 and q_vals.shape[-1] == 2:
+                q1, q2 = q_vals[..., 0], q_vals[..., 1]
+                q_min = np.minimum(q1, q2)
+                eval_metrics['evaluation/critic_q1_mean'] = float(np.mean(q1))
+                eval_metrics['evaluation/critic_q2_mean'] = float(np.mean(q2))
+                eval_metrics['evaluation/critic_q_min_mean'] = float(np.mean(q_min))
+                eval_metrics['evaluation/critic_ensemble_disagreement'] = float(np.mean(np.std(q_vals, axis=-1)))
+                eval_metrics['evaluation/critic_q1_abs_max'] = float(np.max(np.abs(q1)))
+                eval_metrics['evaluation/critic_q2_abs_max'] = float(np.max(np.abs(q2)))
+        except Exception:
+            pass
+
+        # Actor action stats + behavior divergence (offline RL debugging).
+        try:
+            if not config.get('discrete', False):
+                actor_goals = eval_batch.get('actor_goals', None)
+                if actor_goals is None:
+                    actor_goals = eval_batch.get('value_goals', None)
+                if actor_goals is not None:
+                    dist = eval_agent.network.select('actor')(eval_batch['observations'], actor_goals)
+                    a_mode = np.asarray(dist.mode())
+                    eval_metrics['evaluation/action_mean'] = float(np.mean(a_mode))
+                    eval_metrics['evaluation/action_std'] = float(np.std(a_mode))
+                    a_norm = np.linalg.norm(a_mode, axis=-1)
+                    eval_metrics['evaluation/action_norm_mean'] = float(np.mean(a_norm))
+                    eval_metrics['evaluation/action_norm_std'] = float(np.std(a_norm))
+                    eval_metrics['evaluation/action_abs_max'] = float(np.max(np.abs(a_mode)))
+                    eval_metrics['evaluation/action_saturation_frac'] = float(np.mean((np.abs(a_mode) > 0.99).astype(np.float32)))
+
+                    if 'actions' in eval_batch:
+                        a_b = np.asarray(eval_batch['actions'])
+                        diff = a_mode - a_b
+                        eval_metrics['evaluation/policy_behavior_mse'] = float(np.mean(diff**2))
+                        eval_metrics['evaluation/policy_behavior_l2'] = float(np.mean(np.linalg.norm(diff, axis=-1)))
+                        eval_metrics['evaluation/policy_behavior_max_diff'] = float(np.max(np.abs(diff)))
+        except Exception:
+            pass
+
         eval_metrics['time/eval_time'] = time.time() - eval_start
         eval_metrics['time/total_time'] = time.time() - first_time
         wandb.log(eval_metrics, step=step)
