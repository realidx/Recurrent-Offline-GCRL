+    # Fallback: deep search within the agent state.
+    if _deep_has_key(agent_state, lambda k: k == 'ln'):
+        return True
+    if _deep_has_key(agent_state, lambda k: isinstance(k, str) and k.startswith('LayerNorm_')):
+        return False
+    return None
