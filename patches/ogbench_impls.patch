+class ResNetBlock(nn.Module):
+    hidden_dim: int
+    layer_norm: bool = True
+    layerscale_init: float = 1e-2
+
+    @nn.compact
+    def __call__(self, h):
+        h1 = h
+        if self.layer_norm:
+            h1 = nn.LayerNorm()(h1)
+        u = nn.Dense(self.hidden_dim)(h1)
+        u = nn.silu(u)
+        u = nn.Dense(self.hidden_dim)(u)
+
+        scale = self.param('layerscale', nn.initializers.constant(self.layerscale_init), (self.hidden_dim,))
+        u = u * scale
+        return h + u
+
+
+class DeepResNetBackbone(nn.Module):
+    hidden_dim: int
+    out_dim: int
+    num_blocks: int
+    layer_norm: bool = True
+    layerscale_init: float = 1e-2
+
+    @nn.compact
+    def __call__(self, x):
+        h = nn.Dense(self.hidden_dim)(x)
+        for _ in range(int(self.num_blocks)):
+            h = ResNetBlock(self.hidden_dim, layer_norm=self.layer_norm, layerscale_init=self.layerscale_init)(h)
+        return nn.Dense(self.out_dim)(h)
+
+
+class RecurTiedBackbone(nn.Module):
+    hidden_dim: int
+    out_dim: int
+    num_iters: int
+    max_iters: int = 32
+    layer_norm: bool = True
+    layerscale_init: float = 1e-2
+
+    @nn.compact
+    def __call__(self, x, *, num_iters=None):
+        iters = self.num_iters if num_iters is None else int(num_iters)
+        if iters > self.max_iters:
