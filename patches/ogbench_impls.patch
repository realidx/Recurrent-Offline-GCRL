+            film_fc2 = nn.Dense(2 * self.hidden_dim, name='film_fc2')
+            fc1_out = step_proj(step_embed) + h_proj(h1)
+            film = film_fc2(self.activations(fc1_out))
+            gamma, beta = jnp.split(film, 2, axis=-1)
+            h1 = (1.0 + gamma) * h1 + beta
+        u = h1
